{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "next-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "-p",
        "3001"
      ],
      "port": 3001
    },
    {
      "name": "next-start-season-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3100"
      ],
      "env": {
        "SEASON_PREVIEW_DATE": "2026-12-20"
      },
      "port": 3100
    },
    {
      "name": "blog-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3200"
      ],
      "port": 3200,
      "env": {
        "COMMERCE_PROVIDER": "mock"
      }
    }
  ]
}